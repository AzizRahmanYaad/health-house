# ---------------------------------------------------------------------
#  Health House — environment
#  Copy to .env.local (development) or set these on your host.
# ---------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgres://healthhouse:healthhouse@localhost:5432/healthhouse

# Set to "require" on hosts that need TLS (Neon, Supabase, Render, …)
# DATABASE_SSL=require

# Long random string used to sign the session cookie (32+ chars)
SESSION_SECRET=change-me-to-a-long-random-string

# Where uploaded videos / PDFs / avatars are stored (absolute or relative to the project)
UPLOAD_DIR=./uploads

# Largest upload accepted, in bytes (200 MB)
MAX_UPLOAD_SIZE=209715200

# Timezone used for every displayed date
APP_TIMEZONE=Asia/Kabul

# Branding
APP_NAME=Health House
APP_SHORT=Health House
APP_INSTITUTION=Midwifery Education

# One-time browser installer: set any long random text, open /api/setup?token=<it>, then remove it
# SETUP_TOKEN=
